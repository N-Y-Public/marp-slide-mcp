# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Temporary Files
build/
dist/
output/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*_temp.html
*.tsbuildinfo

# Marp & Slide Generated Outputs (Local preview/exports)
slides/*.pdf
slides/*.pptx
slides/*.html
slides/*.png
slides/*.jpeg
