# Environment variables & secrets (CRITICAL for OSS / Privacy)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# IDE & OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# VS Code / Antigravity IDE
# Keep workspace settings and extensions, ignore local user state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.json
.history/

# Testing & Coverage
coverage/
.nyc_output/

# Docker local data (if any mounts write to host)
.docker/
docker-data/
