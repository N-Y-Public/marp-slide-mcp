{
  "daily_report": {
    "enabled": true,
    "schedules_jst": [
      "07:30",
      "11:50",
      "18:00"
    ],
    "slot_mapping": {
      "07:30": {
        "slot": "morning",
        "code": "AM",
        "label": "朝刊"
      },
      "11:50": {
        "slot": "midday",
        "code": "MD",
        "label": "昼刊"
      },
      "18:00": {
        "slot": "evening",
        "code": "PM",
        "label": "夕刊"
      }
    },
    "template_path": "docs/templates/tpl_96_daily_report.md",
    "output_dir": "docs/reports/daily",
    "target_audience": "ROLE-MAINTAINER"
  },
  "weekly_report": {
    "enabled": true,
    "day_of_week": "WED",
    "time_jst": "16:00",
    "also_emit_daily_report": true,
    "template_path": "docs/templates/tpl_97_weekly_report.md",
    "output_dir": "docs/reports/weekly",
    "target_audience": "ROLE-PROJECT-DIRECTOR"
  },
  "multi_agent_gate": {
    "enforce_distinct_stage_reviewer": true,
    "drafter_role": "ROLE-PM",
    "reviewer_role": "ROLE-ARCH",
    "qa_auditor_role": "ROLE-QA",
    "max_stage_a_retry": 2
  },
  "identity_gate": {
    "expected_github_login": "N-Y-Public",
    "expected_github_id": 330902043
  },
  "daemon": {
    "github_repo": "N-Y-Public/marp-slide-mcp",
    "max_concurrent_issues": 1,
    "poll_interval_seconds": 30,
    "state_file_path": "docs/reports/daemon_state.json",
    "pr_drafts_dir": "docs/reports/pr_drafts",
    "worker_commands": {
      "stage_a": "agy chat --headless --prompt \"Issue #{issue_number} に対して Stage A (PBI起票) のみを実行せよ\"",
      "review_gate": "python3 scripts/autonomous_dev_loop.py review-gate --pbi {pbi_path} --drafter {drafter_role} --reviewer {reviewer_role}",
      "stage_b": "agy chat --headless --prompt \"PBI {pbi_id} ({pbi_path}) に対して Stage B (設計・実装・テスト・RTM更新) を完遂せよ\""
    },
    "dod_commands": [
      "npm run build",
      "python3 -m unittest discover -s tests -p \"test_*.py\"",
      "python3 .agents/skills/ipa-traceability-validator/scripts/verify_rtm.py"
    ]
  }
}
